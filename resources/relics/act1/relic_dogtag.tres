description = "명부에 없는 자에게 남은 유일한 신분 증명. 치명적 피해를 런당 1회 무효로 하고 쉼터에서 다시 채운다."
designer_note = "C축 진품 현대. 부활류는 강력하므로 런당 1회로 제한 (docs/systems/RELICS.md 6.2 17번). boss 소스 추가는 2026-08-05 D6(6.3절 막 보스 진품 확정 드랍)에 따른 활성화다. 현재 M2 진품 등급 유일종이라 문얼굴/방망이 보상이 이 유물로 확정된다."
effects = Array[RelicEffect]([SubResource("eff_survive")])
